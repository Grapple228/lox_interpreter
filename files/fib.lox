fun fib_rec(n) {
    if (n < 2) return n;
    return fib_rec(n - 1) + fib_rec(n - 2);
}

fun fib_iter(n) {
    var a = 0;
    var b = 1;

    for (var i = 0; i < n; i = i + 1) {
        var temp = a + b;
        a = b;
        b = temp;
    }

    return a;
}

var count = 40;

var start = clock();
var result = fib_iter(count);
var elapsed = clock() - start;
print fib_iter + " with result " + result + " took " + elapsed;


var start = clock();
var result = fib_rec(count);
var elapsed = clock() - start;
print fib_rec + "  with result " + result + " took " + elapsed;
