fun fib_rec(n) {
    if (n < 2) return n;
    return fib_rec(n - 1) + fib_rec(n - 2);
}



fun fib_iter(n) {
    var a = 0;
    var b = 1;

    for (var i = 0; i < n; i = i + 1) {
        var temp = a + b;
        a = b;
        b = temp;
    }

    return a;
}

var count = 40;

print "fib_iter()";
start = clock();
print fib_iter(count);
print clock() - start;

print "fib_rec()";
var start = clock();
print fib_rec(count);
print clock() - start;
